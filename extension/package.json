{
  "name": "sruja",
  "displayName": "Sruja – Context engineering for the AI era.",
  "description": "Sruja – Context engineering for the AI era.: diagnostics, syntax highlighting, snippets, markdown export, and AI features (skills, rules)",
  "version": "0.31.0",
  "publisher": "SrujaAI",
  "icon": "sruja-logo.png",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sruja-ai/sruja.git"
  },
  "homepage": "https://github.com/sruja-ai/sruja/blob/main/extension/README.md",
  "bugs": {
    "url": "https://github.com/sruja-ai/sruja/issues"
  },
  "keywords": [
    "sruja",
    "architecture",
    "context engineering",
    "ai era",
    "dsl",
    "c4",
    "diagram",
    "lint",
    "snippets"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:sruja",
    "workspaceContains:**/*.sruja",
    "onStartupFinished",
    "onView:srujaSkillsView"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "sruja",
        "icon": {
          "light": "./sruja-logo.png",
          "dark": "./sruja-logo.png"
        },
        "aliases": [
          "Sruja",
          "sruja"
        ],
        "extensions": [
          ".sruja"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sruja",
        "scopeName": "source.sruja",
        "path": "./syntaxes/sruja.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "sruja",
        "path": "./snippets/sruja.json"
      }
    ],
    "configuration": {
      "title": "Sruja – Context engineering for the AI era.",
      "properties": {
        "sruja.lsp.path": {
          "type": "string",
          "default": "",
          "description": "Path to the Sruja CLI binary. Editor features (lint, export, diagram) use bundled WASM. This path is used only for workspace commands: drift, status, review, refresh context."
        },
        "sruja.skills.path": {
          "type": "string",
          "default": "",
          "description": "Path to skills folder (for AI rules). Empty = use workspace 'skills' or bundled skills."
        }
      }
    },
    "configurationDefaults": {
      "[sruja]": {
        "editor.codeLens": true
      }
    },
    "commands": [
      {
        "command": "sruja.commandCenter",
        "title": "Sruja: Command Center",
        "icon": "$(terminal)",
        "shortTitle": "Command Center"
      },
      {
        "command": "sruja.runValidation",
        "title": "Sruja: Run validation (check after AI/edit)",
        "icon": "$(check-all)",
        "shortTitle": "Validate"
      },
      {
        "command": "sruja.exportMarkdown",
        "title": "Sruja: Export architecture to Markdown",
        "icon": "$(markdown)",
        "shortTitle": "Export"
      },
      {
        "command": "sruja.openDiagramPreview",
        "title": "Sruja: Open Diagram Preview",
        "icon": "$(graph)",
        "shortTitle": "Diagram"
      },
      {
        "command": "sruja.openFocusedDiagramPreview",
        "title": "Sruja: Open Focused Diagram Preview",
        "icon": "$(filter)",
        "shortTitle": "Focused Diagram"
      },
      {
        "command": "sruja.openFocusedDiagramPreviewAt",
        "title": "Sruja: Open Focused Diagram Preview (at element)",
        "icon": "$(filter)",
        "shortTitle": "Focus Here"
      },
      {
        "command": "sruja.openSequenceDiagramPreview",
        "title": "Sruja: Open Sequence Diagram Preview",
        "icon": "$(list-tree)",
        "shortTitle": "Sequence"
      },
      {
        "command": "sruja.openSequenceDiagramPreviewAt",
        "title": "Sruja: Open Sequence Diagram Preview (at scenario/flow)",
        "icon": "$(list-tree)",
        "shortTitle": "Sequence Here"
      },
      {
        "command": "sruja.openComponentKnowledge",
        "title": "Sruja: Open component knowledge",
        "icon": "$(book)",
        "shortTitle": "Docs"
      },
      {
        "command": "sruja.openDocsThread",
        "title": "Sruja: Open Docs & References Thread",
        "icon": "$(references)",
        "shortTitle": "Thread"
      },
      {
        "command": "sruja.openDocsThreadAt",
        "title": "Sruja: Open Docs & References Thread (at element)",
        "icon": "$(references)",
        "shortTitle": "Thread Here"
      },
      {
        "command": "sruja.openSkillsOverview",
        "title": "Sruja: Open Skills Overview",
        "icon": "$(folder-library)",
        "shortTitle": "Skills"
      },
      {
        "command": "sruja.openAgentGuide",
        "title": "Sruja: Open Agent Guide (AGENTS.md)",
        "icon": "$(file-text)",
        "shortTitle": "Agent Guide"
      },
      {
        "command": "sruja.listRules",
        "title": "Sruja: List Rules…",
        "icon": "$(list-unordered)",
        "shortTitle": "Rules"
      },
      {
        "command": "sruja.copyRuleForAI",
        "title": "Sruja: Copy Rule for AI",
        "icon": "$(file-code)",
        "shortTitle": "Copy Rule"
      },
      {
        "command": "sruja.copyAgentGuideForAI",
        "title": "Sruja: Copy Agent Guide for AI",
        "icon": "$(file-text)",
        "shortTitle": "Copy Guide"
      },
      {
        "command": "sruja.runDrift",
        "title": "Sruja: Run drift (architecture health)",
        "icon": "$(pulse)",
        "shortTitle": "Drift"
      },
      {
        "command": "sruja.refreshContext",
        "title": "Sruja: Refresh repo context",
        "icon": "$(sync)",
        "shortTitle": "Refresh Context"
      },
      {
        "command": "sruja.status",
        "title": "Sruja: Status",
        "icon": "$(info)",
        "shortTitle": "Status"
      },
      {
        "command": "sruja.review",
        "title": "Sruja: Review architecture update",
        "icon": "$(eye)",
        "shortTitle": "Review"
      },
      {
        "command": "sruja.markdownPreview",
        "title": "Sruja: Markdown Preview",
        "icon": "$(open-preview)",
        "shortTitle": "Preview"
      },
      {
        "command": "sruja.openMarkdownPreview",
        "title": "Sruja: Open Markdown Preview",
        "icon": "$(open-preview)",
        "shortTitle": "Preview"
      },
      {
        "command": "sruja.copyContextPackForAI",
        "title": "Sruja: Copy Context Pack for AI",
        "icon": "$(copy)",
        "shortTitle": "Copy Context"
      },
      {
        "command": "sruja.registerMcpServer",
        "title": "Sruja: Register MCP Server (Cursor)",
        "icon": "$(plug)",
        "shortTitle": "MCP"
      }
    ],
    "submenus": [
      {
        "id": "sruja.editorSubmenu",
        "label": "Sruja",
        "icon": "$(terminal)"
      }
    ],
    "keybindings": [
      {
        "command": "sruja.commandCenter",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s",
        "when": "editorLangId == sruja"
      },
      {
        "command": "sruja.runValidation",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorLangId == sruja"
      },
      {
        "command": "sruja.openDiagramPreview",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d",
        "when": "editorLangId == sruja"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "sruja.editorSubmenu",
          "group": "sruja",
          "when": "editorLangId == sruja"
        }
      ],
      "sruja.editorSubmenu": [
        {
          "command": "sruja.runValidation",
          "group": "1_validate"
        },
        {
          "command": "sruja.exportMarkdown",
          "group": "1_validate"
        },
        {
          "command": "sruja.openDiagramPreview",
          "group": "2_diagram"
        },
        {
          "command": "sruja.openFocusedDiagramPreview",
          "group": "2_diagram"
        },
        {
          "command": "sruja.openSequenceDiagramPreview",
          "group": "2_diagram"
        },
        {
          "command": "sruja.openComponentKnowledge",
          "group": "3_knowledge"
        },
        {
          "command": "sruja.openDocsThread",
          "group": "3_knowledge"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sruja-view",
          "title": "Sruja",
          "icon": "sruja-logo.png"
        }
      ]
    },
    "views": {
      "sruja-view": [
        {
          "id": "srujaSkillsView",
          "name": "Sruja Skills"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "sruja.markdownPreview",
        "displayName": "Sruja Markdown Preview",
        "selector": [
          {
            "filenamePattern": "*.sruja"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "jest",
    "test:vscode": "npm run compile && node out/test/runTest.js",
    "copy:assets": "bash scripts/copy-assets.sh",
    "package": "npm run copy:assets && npm run compile && vsce package --no-dependencies",
    "install:vsix": "npm run package && echo '\nInstall in Cursor/VS Code: Extensions → ⋯ → Install from VSIX... → select extension/*.vsix\n'",
    "deploy:trae": "npm run package && node -e \"const fs=require('fs');const path=require('path');const cp=require('child_process');const dir=__dirname;const vsix=fs.readdirSync(dir).filter(f=>f.endsWith('.vsix')).map(f=>({f,mtime:fs.statSync(path.join(dir,f)).mtimeMs})).sort((a,b)=>a.mtime-b.mtime).pop();if(!vsix){console.error('No .vsix found.');process.exit(1);}const p=path.join(dir,vsix.f);try{cp.spawnSync('open',['-R',p],{stdio:'ignore'});}catch{}console.log('\\nVSIX ready: '+p+'\\n');console.log('Trae: Extensions → … → Install from VSIX → select that file (or drag it into the Extensions panel).\\n');\""
  },
  "devDependencies": {
    "@types/glob": "^9.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.5.0",
    "@vscode/vsce": "^3.3.2",
    "glob": "^13.0.6",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.6",
    "typescript": "~5.9.0"
  },
  "overrides": {
    "yauzl": "3.2.1"
  }
}
