{
  "name": "sruja-language-support",
  "displayName": "Sruja Language Support",
  "description": "Sruja: diagnostics, syntax highlighting, snippets, markdown export, and AI features (skills, rules)",
  "version": "0.1.0",
  "publisher": "sruja-ai",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/sruja-ai/sruja.git" },
  "homepage": "https://github.com/sruja-ai/sruja/blob/main/extension/README.md",
  "bugs": { "url": "https://github.com/sruja-ai/sruja/issues" },
  "keywords": ["sruja", "architecture", "dsl", "c4", "diagram", "lint", "snippets"],
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages", "Snippets", "Linters", "Formatters"],
  "activationEvents": ["onLanguage:sruja", "onView:srujaSkillsView"],
  "main": "./out/extension.js",
  "extensionKind": ["workspace"],
  "capabilities": { "untrustedWorkspaces": { "supported": true } },
  "contributes": {
    "languages": [{
      "id": "sruja",
      "aliases": ["Sruja", "sruja"],
      "extensions": [".sruja"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "sruja",
      "scopeName": "source.sruja",
      "path": "./syntaxes/sruja.tmLanguage.json"
    }],
    "snippets": [{ "language": "sruja", "path": "./snippets/sruja.json" }],
    "configuration": {
      "title": "Sruja",
      "properties": {
        "sruja.lsp.path": {
          "type": "string",
          "default": "sruja",
          "description": "Path to the Sruja CLI binary (lint and export)."
        },
        "sruja.skills.path": {
          "type": "string",
          "default": "",
          "description": "Path to skills folder (for AI rules). Empty = use workspace 'skills' or bundled skills."
        }
      }
    },
    "commands": [
      { "command": "sruja.runValidation", "title": "Sruja: Run validation (check after AI/edit)" },
      { "command": "sruja.exportMarkdown", "title": "Sruja: Export to Markdown" },
      { "command": "sruja.openSkillsOverview", "title": "Sruja: Open Skills Overview" },
      { "command": "sruja.openAgentGuide", "title": "Sruja: Open Agent Guide (AGENTS.md)" },
      { "command": "sruja.listRules", "title": "Sruja: List Rules…" },
      { "command": "sruja.copyRuleForAI", "title": "Sruja: Copy Rule for AI" },
      { "command": "sruja.copyAgentGuideForAI", "title": "Sruja: Copy Agent Guide for AI" }
    ],
    "menus": {
      "editor/context": [
        { "command": "sruja.runValidation", "when": "editorLangId == sruja" },
        { "command": "sruja.exportMarkdown", "when": "editorLangId == sruja" }
      ]
    },
    "views": {
      "explorer": [{
        "id": "srujaSkillsView",
        "name": "Sruja Skills"
      }]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "typescript": "~5.6.0"
  },
  "dependencies": {}
}
