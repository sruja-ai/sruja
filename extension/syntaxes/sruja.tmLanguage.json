{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sruja",
  "scopeName": "source.sruja",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#tags" },
    { "include": "#keywords" },
    { "include": "#relations" },
    { "include": "#operators" },
    { "include": "#numbers" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.sruja",
          "match": "//.*$"
        },
        {
          "name": "comment.block.sruja",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [{
        "name": "keyword.control.sruja",
        "match": "\\b(system|container|component|person|database|datastore|queue|relation|description|technology|tags|metadata|requirement|adr|policy|category|enforcement|rule|deny|require|edge|from|to|except|message|suggest|on|key|value|meta|scenario|story|flow|step|view|include|exclude|of|recursive|source|id|aliases|owner|domain|criticality|priority|status|acceptance_criteria|user_journey|affects|given|when|then)\\b"
      }]
    },
    "tags": {
      "patterns": [{
        "name": "entity.name.tag.sruja",
        "match": "[@#][A-Za-z_][A-Za-z0-9_-]*\\b"
      }]
    },
    "relations": {
      "patterns": [{
        "name": "keyword.operator.arrow.sruja",
        "match": "->"
      }]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.sruja",
          "match": "="
        }
      ]
    },
    "numbers": {
      "patterns": [{
        "name": "constant.numeric.sruja",
        "match": "\\b\\d+\\b"
      }]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.sruja",
          "begin": "\"",
          "end": "\""
        },
        {
          "name": "string.quoted.single.sruja",
          "begin": "'",
          "end": "'"
        }
      ]
    },
    "identifiers": {
      "patterns": [{
        "name": "variable.other.sruja",
        "match": "\\b[A-Za-z_][A-Za-z0-9_.-]*\\b"
      }]
    }
  }
}
