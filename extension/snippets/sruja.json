{
  "Kind: person": {
    "prefix": ["kind person", "person kind"],
    "body": ["person = kind \"Person\"", "$0"],
    "description": "Declare person kind"
  },
  "Kind: system": {
    "prefix": ["kind system", "system kind"],
    "body": ["system = kind \"System\"", "$0"],
    "description": "Declare system kind"
  },
  "Kind: container": {
    "prefix": ["kind container", "container kind"],
    "body": ["container = kind \"Container\"", "$0"],
    "description": "Declare container kind"
  },
  "Kind: component": {
    "prefix": ["kind component", "component kind"],
    "body": ["component = kind \"Component\"", "$0"],
    "description": "Declare component kind"
  },
  "Kind: database": {
    "prefix": ["kind database", "database kind"],
    "body": ["database = kind \"Database\"", "$0"],
    "description": "Declare database kind"
  },
  "Person element": {
    "prefix": ["person", "person \"\""],
    "body": ["${1:name} = person \"${2:Label}\"", "$0"],
    "description": "Create a person element"
  },
  "System element": {
    "prefix": ["system", "system \"\""],
    "body": ["${1:name} = system \"${2:Label}\"", "$0"],
    "description": "Create a system element"
  },
  "System with body": {
    "prefix": ["system block", "system {}"],
    "body": ["${1:name} = system \"${2:Label}\" {", "  $0", "}"],
    "description": "Create a system with nested elements"
  },
  "Relation": {
    "prefix": ["->", "relation"],
    "body": ["${1:source} -> ${2:target} \"${3:label}\"", "$0"],
    "description": "Create a relation between elements"
  },
  "View": {
    "prefix": ["view", "view index"],
    "body": ["view ${1:index} {", "  include *", "}", "$0"],
    "description": "Define a view with include"
  },
  "Description block": {
    "prefix": ["description"],
    "body": ["description \"${1:Description text}\"", "$0"],
    "description": "Add description"
  },
  "Policy": {
    "prefix": ["policy", "policy {}"],
    "body": [
      "${1:PolicyId} = policy \"${2:Title}\" {",
      "  category \"${3:security}\"",
      "  enforcement \"${4:required}\"",
      "  description \"${5:What this policy enforces}\"",
      "  rule deny edge from { kind \"${6:service}\" } to { kind \"${7:database}\" }",
      "}",
      "$0"
    ],
    "description": "Define a policy with one rule"
  },
  "ADR": {
    "prefix": ["adr", "adr {}"],
    "body": [
      "${1:ADR001} = adr \"${2:Decision title}\" {",
      "  status \"${3:proposed}\"",
      "  context \"${4:Why we need this decision}\"",
      "  decision \"${5:What we decided}\"",
      "  consequences \"${6:Tradeoffs and follow-ups}\"",
      "}",
      "$0"
    ],
    "description": "Define an ADR (architecture decision record)"
  },
  "Scenario": {
    "prefix": ["scenario", "scenario {}"],
    "body": [
      "${1:LoginFlow} = scenario \"${2:User Login}\" \"${3:Optional description}\" {",
      "  step ${4:User} -> ${5:WebApp} \"${6:Credentials}\" [#${7:auth}] order 1",
      "  step ${5:WebApp} -> ${8:DB} \"${9:Verify}\" [#${10:read}] order 2",
      "}",
      "$0"
    ],
    "description": "Define a scenario with ordered steps"
  },
  "Scenario (block form)": {
    "prefix": ["scenario block", "scenario steps []"],
    "body": [
      "${1:LoginFlow} = scenario {",
      "  title \"${2:User Login}\"",
      "  description \"${3:Optional description}\"",
      "  steps [",
      "    step ${4:User} -> ${5:WebApp} \"${6:Credentials}\" [#${7:auth}] order 1",
      "    step ${5:WebApp} -> ${8:DB} \"${9:Verify}\" [#${10:read}] order 2",
      "  ]",
      "}",
      "$0"
    ],
    "description": "Define a scenario using block form (title/description/steps)"
  },
  "Flow": {
    "prefix": ["flow", "flow {}"],
    "body": [
      "${1:UserOnboarding} = flow \"${2:Onboarding}\" \"${3:Optional description}\" {",
      "  step ${4:User} -> ${5:WebApp} \"${6:Start}\" [#${7:ui}] order 1",
      "  step ${5:WebApp} -> ${8:Email} \"${9:Send link}\" [#${10:async}] order 2",
      "}",
      "$0"
    ],
    "description": "Define a flow with ordered steps"
  },
  "Policy rule: deny edge": {
    "prefix": ["rule deny", "deny edge", "rule deny edge"],
    "body": [
      "rule deny edge from { kind \"${1:service}\" } to { kind \"${2:database}\" } message \"${3:Reason}\" suggest \"${4:Preferred alternative}\"",
      "$0"
    ],
    "description": "Deny edges matching from/to selectors"
  },
  "Policy rule: require tags": {
    "prefix": ["rule require tags", "require tags"],
    "body": [
      "rule require tags on { kind \"${1:database}\" } tags [\"${2:encrypted}\"]",
      "$0"
    ],
    "description": "Require tags on elements matching selector"
  },
  "Policy rule: require metadata": {
    "prefix": ["rule require metadata", "require metadata"],
    "body": [
      "rule require metadata on { kind \"${1:container}\" } key \"${2:owner}\"",
      "$0"
    ],
    "description": "Require metadata key (and optional value) on elements matching selector"
  },
  "Policy rule: require slo": {
    "prefix": ["rule require slo", "require slo"],
    "body": [
      "rule require slo on { kind \"${1:container}\" tag \"${2:production}\" }",
      "$0"
    ],
    "description": "Require SLO metadata on elements matching selector"
  },
  "Policy selector": {
    "prefix": ["selector {}", "policy selector"],
    "body": ["{ kind \"${1:container}\" tag \"${2:production}\" }$0"],
    "description": "Create a policy selector block"
  },
  "Source: OpenAPI": {
    "prefix": ["source openapi", "openapi"],
    "body": ["source openapi \"${1:./specs/api.yaml}\"", "$0"],
    "description": "Add OpenAPI spec source binding"
  },
  "Source: Kubernetes": {
    "prefix": ["source kubernetes", "kubernetes", "k8s"],
    "body": ["source kubernetes \"${1:./k8s/}\"", "$0"],
    "description": "Add Kubernetes manifest source binding"
  },
  "Source: AsyncAPI": {
    "prefix": ["source asyncapi", "asyncapi"],
    "body": ["source asyncapi \"${1:./specs/events.yaml}\"", "$0"],
    "description": "Add AsyncAPI spec source binding"
  },
  "Source: Terraform": {
    "prefix": ["source terraform", "terraform"],
    "body": ["source terraform \"${1:./infra/}\"", "$0"],
    "description": "Add Terraform source binding"
  },
  "Source: Dockerfile": {
    "prefix": ["source dockerfile", "dockerfile"],
    "body": ["source dockerfile \"${1:./Dockerfile}\"", "$0"],
    "description": "Add Dockerfile source binding"
  },
  "Source: Docs": {
    "prefix": ["source docs", "docs"],
    "body": ["source docs \"${1:./docs/architecture.md}\"", "$0"],
    "description": "Add documentation source binding"
  },
  "Source: README": {
    "prefix": ["source readme", "readme"],
    "body": ["source readme \"${1:./README.md}\"", "$0"],
    "description": "Add README source binding"
  },
  "Source: Proto": {
    "prefix": ["source proto", "proto"],
    "body": ["source proto \"${1:./proto/service.proto}\"", "$0"],
    "description": "Add Protocol Buffer source binding"
  },
  "Source: Config": {
    "prefix": ["source config", "config"],
    "body": ["source config \"${1:./config/config.yaml}\"", "$0"],
    "description": "Add configuration file source binding"
  },
  "Source: GraphQL": {
    "prefix": ["source graphql", "graphql"],
    "body": ["source graphql \"${1:./graphql/schema.graphql}\"", "$0"],
    "description": "Add GraphQL schema source binding"
  },
  "Source: Helm": {
    "prefix": ["source helm", "helm"],
    "body": ["source helm \"${1:./helm/}\"", "$0"],
    "description": "Add Helm chart source binding"
  },
  "ID (canonical)": {
    "prefix": ["id", "canonical id"],
    "body": ["id \"${1:canonical.id}\"", "$0"],
    "description": "Set canonical ID for cross-system reference"
  },
  "Aliases": {
    "prefix": ["aliases"],
    "body": ["aliases [\"${1:alias1}\", \"${2:alias2}\"]", "$0"],
    "description": "Define alternative names found in codebase"
  },
  "Owner": {
    "prefix": ["owner"],
    "body": ["owner \"${1:team-name}\"", "$0"],
    "description": "Set owner team or individual"
  },
  "Domain": {
    "prefix": ["domain"],
    "body": ["domain \"${1:business-domain}\"", "$0"],
    "description": "Set business domain"
  },
  "Criticality: high": {
    "prefix": ["criticality high"],
    "body": ["criticality high", "$0"],
    "description": "Set high criticality level"
  },
  "Criticality: critical": {
    "prefix": ["criticality critical"],
    "body": ["criticality critical", "$0"],
    "description": "Set critical criticality level"
  },
  "Criticality: low": {
    "prefix": ["criticality low"],
    "body": ["criticality low", "$0"],
    "description": "Set low criticality level"
  },
  "Criticality: medium": {
    "prefix": ["criticality medium"],
    "body": ["criticality medium", "$0"],
    "description": "Set medium criticality level"
  }
}
