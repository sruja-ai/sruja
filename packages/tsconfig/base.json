{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "FAANG Quality Base Configuration",
  "compilerOptions": {
    // ========================================================================
    // Language and Environment
    // ========================================================================
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,

    // ========================================================================
    // Type Checking - FAANG Standard Strictness
    // ========================================================================
    "strict": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "alwaysStrict": true,

    // Additional strict checks for production quality
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "exactOptionalPropertyTypes": true,
    "noErrorTruncation": true,

    // ========================================================================
    // Module and Path Resolution
    // ========================================================================
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "isolatedModules": true,

    // Monorepo path mapping
    "baseUrl": ".",
    "paths": {
      "@sruja/shared/*": ["packages/shared/src/*"],
      "@sruja/ui/*": ["packages/ui/src/*"],
      "@sruja/eslint-config/*": ["packages/eslint-config/src/*"]
    },

    // ========================================================================
    // Interop Constraints
    // ========================================================================
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,

    // ========================================================================
    // Emit Options (for library packages)
    // ========================================================================
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSourceMap": false,
    "inlineSources": false,
    "removeComments": false,

    // ========================================================================
    // Advanced Options
    // ========================================================================
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "preserveConstEnums": false,

    // ========================================================================
    // Completeness
    // ========================================================================
    "skipDefaultLibCheck": false,

    // ========================================================================
    // Performance Optimizations
    // ========================================================================
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo"
  },
  "exclude": [
    "node_modules",
    "dist",
    "build",
    ".next",
    "coverage",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ]
}
