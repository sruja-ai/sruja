{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Next.js TypeScript Configuration",
  "extends": "./base.json",
  "compilerOptions": {
    // ========================================================================
    // Next.js Specific Module Resolution
    // ========================================================================
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "allowJs": true,

    // ========================================================================
    // Path Aliases for Monorepo
    // ========================================================================
    "paths": {
      "@sruja/*": ["../../packages/*/src"],
      "@/*": ["./src/*"],
      "@sruja/shared": ["../../packages/shared/src"],
      "@sruja/shared/*": ["../../packages/shared/src/*"],
      "@sruja/ui": ["../../packages/ui/src"],
      "@sruja/ui/*": ["../../packages/ui/src/*"],
      "@sruja/eslint-config": ["../../packages/eslint-config/src"]
    },

    // ========================================================================
    // Next.js Plugin Integration
    // ========================================================================
    "plugins": [
      {
        "name": "next"
      }
    ],

    // ========================================================================
    // Incremental Compilation
    // ========================================================================
    "incremental": true,

    // ========================================================================
    // Emit Options (Next.js handles this, but set for type checking)
    // ========================================================================
    "noEmit": true,

    // ========================================================================
    // Experimental Features (enable as Next.js adds support)
    // ========================================================================
    "skipDefaultLibCheck": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "out",
    "dist",
    "build",
    "coverage",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**"
  ]
}
