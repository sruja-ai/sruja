// Example 2: Microservices Platform - Consolidated Architecture
// This example demonstrates a complete e-commerce microservices architecture
// Note: All services are defined in one file for current Sruja implementation

// ==================== USER SERVICE ====================
user_service = system "User Service" {
  description "User management and authentication"

  api = container "User API" {
    technology "Node.js"
    description "REST API for user operations"
  }

  db = datastore "User Database" {
    technology "PostgreSQL"
    description "User profiles and credentials"
  }

  cache = datastore "Session Cache" {
    technology "Redis"
    description "Active user sessions"
  }

  api -> db "SQL"
  api -> cache "Redis protocol"
}

// ==================== ORDER SERVICE ====================
order_service = system "Order Service" {
  description "Order processing and management"

  api = container "Order API" {
    technology "Python"
    description "REST API for order operations"
  }

  worker = container "Order Worker" {
    technology "Python"
    description "Background order processing"
  }

  db = datastore "Order Database" {
    technology "MongoDB"
    description "Order documents and history"
  }

  queue = datastore "Message Queue" {
    technology "RabbitMQ"
    description "Order event stream"
  }

  api -> db "MongoDB protocol"
  worker -> db "MongoDB protocol"
  api -> queue "AMQP - publishes order events"
  queue -> worker "AMQP - consumes order events"
}

// ==================== PAYMENT SERVICE ====================
payment_service = system "Payment Service" {
  description "Payment processing and management"

  api = container "Payment API" {
    technology "Go"
    description "gRPC API for payment operations"
  }

  worker = container "Payment Worker" {
    technology "Go"
    description "Background payment processing and webhook handling"
  }

  db = datastore "Payment Database" {
    technology "PostgreSQL"
    description "Payment transactions and audit logs"
  }

  cache = datastore "Payment Cache" {
    technology "Redis"
    description "Payment session and idempotency keys"
  }

  api -> db "SQL"
  api -> cache "Redis protocol"
  worker -> db "SQL"
  worker -> cache "Redis protocol"
}

// ==================== CROSS-SERVICE RELATIONSHIPS ====================
order_service.api -> user_service.api "REST - validate user"
order_service.api -> payment_service.api "gRPC - process payment"

// ==================== EXTERNAL SYSTEMS ====================
stripe = external_system "Stripe" {
  description "Payment gateway"

  payment_api = container "Payment API" {
    technology "REST"
    metadata {
      base_url "https://api.stripe.com/v1"
      usage "charge creation, refund processing"
    }
  }
}

payment_service.api -> stripe.payment_api "HTTPS"

// ==================== END USERS ====================
shopper = person "Shopper" {
  description "E-commerce customer browsing and purchasing"

  metadata {
    segment "e-commerce"
    behaviors "browse products, add to cart, checkout, track orders"
  }
}

shopper -> user_service.api "HTTPS - account management"
shopper -> order_service.api "HTTPS - place orders"
