// RudderStack Server — architecture from repo evidence (runner, app, embeddedAppHandler, cluster.Dynamic).
// Enriched: core pipeline as containers, JobsDB split into logical stores, optional externals.

// External actors: person = human, system = external software
Developer = person "Developer" {
  description "Sends events via SDKs or HTTP API"
}

ControlPlane = system "Control Plane" {
  description "RudderStack config backend (e.g. api.rudderstack.com); provides workspace config"
}

Destinations = system "Destinations" {
  description "External warehouses and tools (90+); receive forwarded events"
}

Transformer = system "Transformer" {
  description "External transform service (rudder-transformer image); HTTP"
}

Pulsar = system "Pulsar" {
  description "Optional event stream; Schema Forwarder publishes event schemas when EventSchemas2.enabled"
}

ObjectStorage = system "Object Storage" {
  description "Optional (S3/MinIO); Archiver uploads archived jobs via fileuploader"
}

// Main system
RudderStack = system "RudderStack Server" {
  description "Customer Data Platform: collect, transform, route events to warehouses and tools"

  // Core pipeline (embedded in one binary; can run EMBEDDED, GATEWAY-only, or PROCESSOR-only)
  Gateway = container "Gateway" {
    technology "Go"
    description "Ingests events via HTTP/SDK; validates, throttles; writes to GatewayDB"
  }

  Processor = container "Processor" {
    technology "Go"
    description "Reads from GatewayDB; enriches, transforms (via Transformer), applies consent; writes to RouterDB, BatchRouterDB, EventSchemaDB, ArchivalDB"
  }

  Router = container "Router" {
    technology "Go"
    description "Reads from RouterDB; forwards events to Destinations (real-time)"
  }

  BatchRouter = container "Batch Router" {
    technology "Go"
    description "Reads from BatchRouterDB; forwards batched events to Destinations"
  }

  Archiver = container "Archiver" {
    technology "Go"
    description "Reads from ArchivalDB; uploads to Object Storage for retention"
  }

  SchemaForwarder = container "Schema Forwarder" {
    technology "Go"
    description "Reads from EventSchemaDB; forwards to Pulsar (if enabled) or aborts"
  }

  WarehouseWorker = container "Warehouse Worker" {
    technology "Go"
    description "Optional; syncs data to warehouses (BigQuery, Snowflake, etc.). Same repo, embedded or separate mode"
  }

  RegulationWorker = container "Regulation Worker" {
    technology "Go"
    description "Separate binary (regulation-worker); handles regulation/consent workflows"
  }

  SuppressionBackupService = container "Suppression Backup Service" {
    technology "Go"
    description "Separate binary (suppression-backup-service); backup for suppression data"
  }

  // Job stores (all PostgreSQL; datasets gw, rt, batch_rt, esch, arc)
  GatewayDB = database "GatewayDB" {
    technology "PostgreSQL"
    description "Gateway job queue (dataset gw)"
  }

  RouterDB = database "RouterDB" {
    technology "PostgreSQL"
    description "Router job queue (dataset rt)"
  }

  BatchRouterDB = database "BatchRouterDB" {
    technology "PostgreSQL"
    description "Batch router job queue (dataset batch_rt)"
  }

  EventSchemaDB = database "EventSchemaDB" {
    technology "PostgreSQL"
    description "Event schema jobs (dataset esch); feeds Schema Forwarder"
  }

  ArchivalDB = database "ArchivalDB" {
    technology "PostgreSQL"
    description "Archival job queue (dataset arc); feeds Archiver"
  }
}

// Relationships — pipeline and externals (evidence: embeddedAppHandler, cluster.Dynamic)
Developer -> RudderStack "uses"
Developer -> RudderStack.Gateway "HTTPS / SDK"
RudderStack.Gateway -> RudderStack.GatewayDB "SQL (writes)"
RudderStack.Gateway -> ControlPlane "HTTPS (backend config)"
RudderStack.Processor -> RudderStack.GatewayDB "SQL (reads)"
RudderStack.Processor -> RudderStack.RouterDB "SQL (writes)"
RudderStack.Processor -> RudderStack.BatchRouterDB "SQL (writes)"
RudderStack.Processor -> RudderStack.EventSchemaDB "SQL (writes)"
RudderStack.Processor -> RudderStack.ArchivalDB "SQL (writes)"
RudderStack.Processor -> Transformer "HTTP (transform)"
RudderStack.Processor -> ControlPlane "HTTPS (backend config)"
RudderStack.Router -> RudderStack.RouterDB "SQL (reads)"
RudderStack.Router -> ControlPlane "HTTPS (backend config)"
RudderStack.Router -> Destinations "HTTPS / vendor APIs (forward events)"
RudderStack.BatchRouter -> RudderStack.BatchRouterDB "SQL (reads)"
RudderStack.BatchRouter -> ControlPlane "HTTPS (backend config)"
RudderStack.BatchRouter -> Destinations "HTTPS / vendor APIs (batch forward)"
RudderStack.Archiver -> RudderStack.ArchivalDB "SQL (reads)"
RudderStack.Archiver -> ObjectStorage "upload (S3/MinIO)"
RudderStack.SchemaForwarder -> RudderStack.EventSchemaDB "SQL (reads)"
RudderStack.SchemaForwarder -> Pulsar "publishes (optional)"
RudderStack.WarehouseWorker -> RudderStack.GatewayDB "SQL"
RudderStack.WarehouseWorker -> Destinations "vendor APIs (warehouse sync)"
RudderStack.RegulationWorker -> RudderStack.GatewayDB "SQL"
RudderStack.SuppressionBackupService -> RudderStack.GatewayDB "SQL"

// OPEN QUESTIONS (evidence incomplete)
// - RegulationWorker / SuppressionBackupService: exact JobsDB dataset or dedicated store not confirmed
// - Reporting DB and tracked_users DB: optional features; not modeled

// --- ADRs (Architecture Decision Records) ---
ADR001 = adr "Single binary with pipeline stages as logical containers" {
  status "accepted"
  context "Need ingest, transform, route, and archive with clear boundaries; same team owns the pipeline; deploy flexibility (embedded vs gateway-only vs processor-only)."
  decision "Ship one Core Server binary with Gateway, Processor, Router, BatchRouter, Archiver, SchemaForwarder as in-process pipeline; use APP_TYPE (EMBEDDED/GATEWAY/PROCESSOR) and cluster.Dynamic to run subsets."
  consequences "Gain: single deployable, simpler ops, no network hops between stages. Trade-off: scale is per-binary; partition migration and separate gateway/processor nodes address horizontal scaling."
}

ADR002 = adr "PostgreSQL for all job queues (JobsDB)" {
  status "accepted"
  context "Need durable, ordered job queues for gateway, processor, router, batch router, event schema, and archival with at-least-once semantics and partitioning."
  decision "Use one PostgreSQL instance with multiple dataset tables (gw, rt, batch_rt, esch, arc); jobsdb package with read/write/read-write handles and partition support."
  consequences "Gain: one datastore, ACID, well-understood ops. Trade-off: DB is bottleneck under very high throughput; tuning (pools, partitions) and optional separate writer handles mitigate."
}

ADR003 = adr "External Transformer for event transformation" {
  status "accepted"
  context "User-defined and destination transforms are JavaScript-based; must run in a controlled, versioned runtime."
  decision "Delegate transformation to rudder-transformer service (separate image); Core Server calls it over HTTP (DEST_TRANSFORM_URL)."
  consequences "Gain: isolated transform runtime, language flexibility, independent upgrade. Trade-off: network dependency; processor retries and handles transformer unavailability."
}

ADR004 = adr "Backend config from Control Plane" {
  status "accepted"
  context "Workspace config (sources, destinations, transformations) must be centralized and updatable without redeploy."
  decision "Fetch config from Control Plane (CONFIG_BACKEND_URL, e.g. api.rudderstack.com); backendconfig package caches and notifies; Gateway, Processor, Router, BatchRouter depend on it."
  consequences "Gain: dynamic config, single source of truth. Trade-off: dependency on Control Plane availability; startup and config-wait behavior documented."
}

// --- Scenarios (user-story style) ---
ScenarioEventIngestion = scenario "Developer sends event to pipeline" {
  step Developer -> RudderStack.Gateway "Sends event (HTTPS / SDK)"
  step RudderStack.Gateway -> RudderStack.GatewayDB "Stores job"
  step RudderStack.Processor -> RudderStack.GatewayDB "Reads job"
  step RudderStack.Processor -> Transformer "Transforms (HTTP)"
  step RudderStack.Processor -> RudderStack.RouterDB "Writes router job"
  step RudderStack.Router -> RudderStack.RouterDB "Reads job"
  step RudderStack.Router -> Destinations "Forwards event"
}

ScenarioWarehouseSync = scenario "Warehouse worker syncs to destination" {
  step RudderStack.WarehouseWorker -> RudderStack.GatewayDB "Reads jobs"
  step RudderStack.WarehouseWorker -> Destinations "Syncs to warehouse (vendor APIs)"
}

// --- Flows (DFD-style; modeled as scenarios for lint/relation support) ---
FlowEventPipeline = scenario "Event ingestion to delivery (DFD)" {
  step Developer -> RudderStack.Gateway "HTTPS / SDK (event payload)"
  step RudderStack.Gateway -> RudderStack.GatewayDB "SQL (write job)"
  step RudderStack.Processor -> RudderStack.GatewayDB "SQL (read job)"
  step RudderStack.Processor -> Transformer "HTTP (transform)"
  step RudderStack.Processor -> RudderStack.RouterDB "SQL (write)"
  step RudderStack.Processor -> RudderStack.BatchRouterDB "SQL (write)"
  step RudderStack.Router -> RudderStack.RouterDB "SQL (read)"
  step RudderStack.Router -> Destinations "HTTPS / vendor APIs (forward)"
  step RudderStack.BatchRouter -> RudderStack.BatchRouterDB "SQL (read)"
  step RudderStack.BatchRouter -> Destinations "HTTPS / vendor APIs (batch forward)"
}

FlowArchival = scenario "Archival and schema forwarding (DFD)" {
  step RudderStack.Processor -> RudderStack.ArchivalDB "SQL (write)"
  step RudderStack.Archiver -> RudderStack.ArchivalDB "SQL (read)"
  step RudderStack.Archiver -> ObjectStorage "Upload (S3/MinIO)"
  step RudderStack.Processor -> RudderStack.EventSchemaDB "SQL (write)"
  step RudderStack.SchemaForwarder -> RudderStack.EventSchemaDB "SQL (read)"
  step RudderStack.SchemaForwarder -> Pulsar "Publish (optional)"
}

// Link scenarios and flows to the system (satisfy orphan check)
RudderStack -> ScenarioEventIngestion "documents"
RudderStack -> ScenarioWarehouseSync "documents"
RudderStack -> FlowEventPipeline "documents"
RudderStack -> FlowArchival "documents"
