// examples/causal_loops_basic.sruja
// Causal Loops Example - Demonstrates causal relationships with polarity and delays

// ============================================================================
// CAUSAL VARIABLES
// ============================================================================
// Define abstract variables used in causal loops
// In real systems thinking, these are often abstract concepts
// Here we define them as simple "variable" elements for parsing

variable = kind "Variable"

pressure = variable "Work Pressure"
effort = variable "Effort"
burnout = variable "Burnout"
quality = variable "Work Quality"
demand = variable "Demand"
inventoryLevel = variable "Inventory Level"
reorder = variable "Reorder"
inTransit = variable "In Transit"
customerDemand = variable "Customer Demand"
systemQuality = variable "System Quality"
marketDemand = variable "Market Demand"
revenue = variable "Revenue"
investment = variable "Investment"
capacity = variable "Capacity"

// ============================================================================
// REINFORCING CAUSAL LOOP: Productivity Loop
// Work pressure creates a vicious cycle of burnout and reduced quality
ProductivityLoop = causal_loop "Productivity Loop" {
  loop_type "reinforcing"
  loop_id "R1"
  description "Work pressure creates a vicious cycle of burnout and reduced quality"

  pressure -> effort {
    effect "leads to"
    polarity "+"
  }

  effort -> burnout {
    effect "increases"
    polarity "+"
  }

  burnout -> quality {
    effect "decreases"
    polarity "-"
    delay "1-2 weeks"
  }

  quality -> pressure {
    effect "increases"
    polarity "+"
  }
}

// ============================================================================
// BALANCING CAUSAL LOOP: Inventory Management Loop
// Balancing loop for inventory management with delays
InventoryLoop = causal_loop "Inventory Management Loop" {
  loop_type "balancing"
  loop_id "B1"
  description "Balancing loop for inventory management with delivery delays"

  demand -> inventoryLevel {
    effect "depletes"
    polarity "-"
  }

  inventoryLevel -> reorder {
    effect "triggers when low"
    polarity "+"
  }

  reorder -> inTransit {
    effect "ships"
    polarity "+"
    delay "2 weeks delivery"
  }

  inTransit -> inventoryLevel {
    effect "restocks"
    polarity "+"
  }
}

// ============================================================================
// SYSTEM ARCHETYPES
// ============================================================================

// Growth and Underinvestment Archetype
// Success creates demand, but underinvestment in capacity leads to slowdown
GrowthUnderinvestment = causal_loop "Growth and Underinvestment" {
  loop_type "reinforcing"
  loop_id "R2"
  description "Growth loop competes with underinvestment loop"

  systemQuality -> marketDemand {
    effect "attracts"
    polarity "+"
  }

  marketDemand -> revenue {
    effect "generates"
    polarity "+"
  }

  revenue -> investment {
    effect "enables"
    polarity "+"
  }

  investment -> capacity {
    effect "builds"
    polarity "+"
  }

  capacity -> systemQuality {
    effect "supports"
    polarity "+"
  }
}

// Cross-loop connections (ensures all elements participate in relations)
customerDemand -> demand "drives"
demand -> inventoryLevel "inventory depletion"
ProductivityLoop -> InventoryLoop "different domain"
GrowthUnderinvestment -> ProductivityLoop "archetype"
