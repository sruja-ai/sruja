// examples/course/ecommerce.sruja
// E-Commerce System

person = kind "Person"
system = kind "System"
container = kind "Container"
component = kind "Component"
database = kind "Database"
queue = kind "Queue"

  // Module 2: Context
  customer = person "Online Customer" {
    description "Browses and buys products."
  }

  paymentGateway = system "Stripe"
  emailService = system "SendGrid"

  ecommerce = system "E-Commerce Platform" {
    description "Allows customers to buy products online."

    // Module 3: Containers
    webApp = container "Storefront" {
      description "Customer-facing web application"
      technology "React"
      tags ["frontend"]
      
      // Module 7: Properties & Styles
      metadata {
        framework "Next.js"
        hosting "Vercel"
      }
      style {
        shape "browser"
      }
    }

    api = container "Product API" {
      description "API backend"
      technology "Go"
      tags ["backend"]
    }

    // Module 4: Components (defined outside due to parser limitations)
    productService = component "Product Service"
    productRepo = component "Product Repository"

    db = database "Product Database" {
      technology "PostgreSQL"
      metadata {
        version "15"
        storage "100GB"
      }
    }

    events = queue "Order Events" {
      technology "Kafka"
    }

    // Internal Relations
    webApp -> api "fetches data from"
    api -> db "reads and writes to"
    api -> events "publishes to"
  }

  // Component level relations
  productService -> productRepo "uses"
  webApp -> ecommerce "part of"
  api -> ecommerce "part of"
  db -> ecommerce "part of"
  events -> ecommerce "part of"

  // Context Relations
  customer -> webApp "browses via"
  api -> paymentGateway "processes payments through"
  api -> emailService "sends emails via"

  // Module 5: Scenarios - using new syntax
  CheckoutFlow = scenario "Checkout Flow" {
    description "User checkout process"
    step customer -> webApp "clicks checkout"
    step webApp -> api "POST /checkout"
    step api -> db "saves order to"
    step api -> paymentGateway "charges card via"
    step api -> events "publishes order created to"
  }

  // Module 7: NFRs - using new syntax
  R1 = requirement performance "API latency < 100ms"
  R2 = requirement nonfunctional "System must be maintainable and extensible"

  // Connect unused elements
  CheckoutFlow -> ecommerce "describes"
  R1 -> api "applies to"
  R2 -> ecommerce "applies to"

  ADR001 = adr "Use Microservices" {
    status "Accepted"
    context "Need independent scaling"
    decision "Adopt microservices architecture"
    consequences "Better scalability, increased complexity"
  }

  view index {
    title "E-Commerce System"
    include *
  }
  
  view containers of ecommerce {
    title "E-Commerce Containers"
    include ecommerce.*
  }
