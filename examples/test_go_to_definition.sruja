// Test file for Go to Definition and Hover features
//
// Hover test:
//   - Hover over "Frontend" below
//   - Should see: kind (system), title, parent (if any)
//
// Go to Definition test:
//   - Place cursor on "Frontend" below and press F12 (or Cmd+Click)
//   - Should navigate to element definition

person = kind "Person"
system = kind "System"
container = kind "Container"

User = person "End User"

Frontend = system "Frontend Application" {
  technology "React"
}

Backend = system "Backend System" {
  description "Core backend system"
  API = container "API Service"
  DB = container "Database"
}

// Try F12 (Go to Definition) on these references:
Frontend -> Backend.API "calls"
User -> Frontend "uses"
// Or hover over them to see element details
