// docs/architecture/sruja-development-workflow.sruja
// Development and build workflow architecture
// Describes how Sruja is developed, tested, and deployed

// Element kinds
person = kind "Person"
system = kind "System"
container = kind "Container"
component = kind "Component"

// Actors
Developer = person "Developer" {
  description "Develops Sruja features and fixes"
}

Maintainer = person "Maintainer" {
  description "Maintains CI/CD and release processes"
}

// Local Development
Local = container "Local Development" {
  technology "Rust, Node.js, npm"
  description "Developer's local environment"
  tags ["development", "ci-cd"]
}

Local_GitHooks = component "Git Hooks" {
  description "Pre-commit hooks for validation"
  technology "Husky, pre-commit"
}

Local_LocalBuild = component "Local Build" {
  description "Building locally before commit"
  technology "cargo, npm"
}

Local_LocalTests = component "Local Tests" {
  description "Running tests locally"
  technology "cargo test, Vitest"
}

// CI/CD Pipeline
CICD = container "CI/CD Pipeline" {
  technology "GitHub Actions"
  description "Continuous Integration and Deployment"
  tags ["ci-cd", "github-actions"]
}

CICD_RustTests = component "Rust Tests" {
  description "Rust unit tests and coverage"
  technology "cargo test, cargo clippy"
}

CICD_TSTests = component "TypeScript Tests" {
  description "TypeScript/JavaScript tests"
  technology "Vitest, Playwright"
}

CICD_SecurityScan = component "Security Scanning" {
  description "Security vulnerability scanning"
  technology "cargo audit, npm audit, TruffleHog"
}

CICD_BuildCheck = component "Build Check" {
  description "Verifies all packages build"
  technology "Turbo, cargo build"
}

CICD_LintCheck = component "Lint Check" {
  description "Code quality checks"
  technology "ESLint, cargo clippy"
}

CICD_CoverageCheck = component "Coverage Check" {
  description "Test coverage validation"
  technology "Codecov, Codacy"
}

CICD_BundleSizeCheck = component "Bundle Size Check" {
  description "Frontend bundle size monitoring"
  technology "size-limit"
}

// Release Process
Release = container "Release Process" {
  technology "cargo, GitHub Actions"
  description "Automated release and publishing"
  tags ["release", "publishing"]
}

Release_VersionBump = component "Version Bump" {
  description "Automatic version bumping"
  technology "release-please"
}

Release_BuildArtifacts = component "Build Artifacts" {
  description "Builds binaries for all platforms"
  technology "cargo build --release"
}

Release_PublishRelease = component "Publish Release" {
  description "Publishes to GitHub Releases"
  technology "GitHub Actions"
}

Release_PublishNPM = component "Publish NPM" {
  description "Publishes TypeScript packages"
  technology "npm publish"
}

// Testing Infrastructure
Testing = container "Testing Infrastructure" {
  technology "Rust, Vitest, Playwright"
  description "Testing tools and infrastructure"
  tags ["testing"]
}

Testing_UnitTests = component "Unit Tests" {
  description "Rust and TypeScript unit tests"
  technology "cargo test, Vitest"
}

Testing_IntegrationTests = component "Integration Tests" {
  description "End-to-end integration tests"
  technology "Playwright"
}

Testing_PropertyTests = component "Property-Based Tests" {
  description "Property-based testing for validation"
  technology "fast-check, Vitest"
}

Testing_ExampleTests = component "Example Tests" {
  description "Validates example .sruja files"
  technology "cargo, sruja-cli"
}

// Relationships
Local -> CICD "Pushes to"
CICD_RustTests -> Testing_UnitTests "Uses"
CICD_TSTests -> Testing_UnitTests "Uses"
CICD_TSTests -> Testing_IntegrationTests "Uses"

CICD -> Release "Triggers on tag"
Release_VersionBump -> Release_BuildArtifacts "Triggers"
Release_BuildArtifacts -> Release_PublishRelease "Publishes"
Release_BuildArtifacts -> Release_PublishNPM "Publishes"

Developer -> Local "Uses"
Developer -> Local_GitHooks "Triggers"
Developer -> Local_LocalBuild "Runs"
Developer -> Local_LocalTests "Runs"

Maintainer -> CICD "Manages"
Maintainer -> Release "Manages"

// Views
view index {
  title "Development Workflow"
  include *
}

view cicd {
  title "CI/CD Pipeline"
  include CICD, Testing
}

view release {
  title "Release Process"
  include Release
}
