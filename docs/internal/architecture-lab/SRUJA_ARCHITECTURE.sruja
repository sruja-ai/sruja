// Sruja Platform Architecture
// Generated architecture-as-code definition

import { * } from 'sruja.ai/stdlib'

// ============================================================
// OVERVIEW
// ============================================================

overview {
    summary "Sruja is an architecture-as-code platform with DSL, validation engine, IDE integration, and AI-powered architecture intelligence"
    audience "Sruja contributors, architects, and AI assistants"
    scope "Core platform modules and their interconnections"
    goals [
        "Define clear module boundaries and responsibilities",
        "Document data flow and dependencies",
        "Guide architectural decisions"
    ]
    nonGoals ["Internal implementation details of each module"]
    risks [
        "Tight coupling between engine and language modules",
        "WASM feature parity with native"
    ]
}

// ============================================================
// PERSONS (Users)
// ============================================================

Developer = person "Developer" {
    description "Software developer using Sruja CLI or VS Code extension"
}

Architect = person "Architect" {
    description "Software architect designing and documenting systems"
}

AI = person "AI Assistant" {
    description "LLM-based assistant (Claude, GPT) using Sruja MCP or CLI"
}

// ============================================================
// SYSTEMS
// ============================================================

SrujaPlatform = system "Sruja Platform" {
    description "Architecture-as-code platform with DSL, validation, and AI integration"

    // ============================================================
    // CONTAINERS - Core Layer
    // ============================================================

    Diagnostics = container "Diagnostics Module" {
        technology "Rust"
        description "Error reporting, severity levels, source locations"
        tags ["core", "shared"]
    }

    Language = container "Language Module" {
        technology "Rust, Nom parser"
        description "DSL parser, AST, lexer, and syntax validation"
        tags ["core"]
    }

    Engine = container "Validation Engine" {
        technology "Rust, Tokio"
        description "Rule-based validation engine with sync/async execution"
        tags ["core"]
    }

    Export = container "Export Module" {
        technology "Rust"
        description "Convert AST to JSON, Mermaid, Markdown, PlantUML"
        tags ["core"]
    }

    // ============================================================
    // CONTAINERS - Interface Layer
    // ============================================================

    CLI = container "CLI Application" {
        technology "Rust, Clap"
        description "Command-line interface for validation, export, diff"
        tags ["interface"]
        scale {
            min 1
            max 1
        }
    }

    LSP = container "LSP Server" {
        technology "Rust, tower-lsp"
        description "Language Server Protocol for IDE integration"
        tags ["interface"]
    }

    WASM = container "WASM Bindings" {
        technology "Rust, wasm-bindgen"
        description "WebAssembly bindings for browser/extension"
        tags ["interface"]
    }

    VSCode = container "VS Code Extension" {
        technology "TypeScript"
        description "Syntax highlighting, diagnostics, diagram preview"
        tags ["interface"]
    }

    // ============================================================
    // CONTAINERS - Intelligence Layer
    // ============================================================

    Graph = container "Knowledge Graph" {
        technology "Rust"
        description "Architecture knowledge graph with nodes, edges, decisions, policies"
        tags ["intelligence"]
    }

    Scan = container "Repository Scanner" {
        technology "Rust, Tree-sitter"
        description "Code analysis to infer architecture from source"
        tags ["intelligence"]
    }

    Diff = container "Drift / Diff" {
        technology "Rust"
        description "Drift detection and delta computation between declared and discovered architecture"
        tags ["intelligence"]
    }

    Intent = container "Intent" {
        technology "Rust"
        description "Intent vs reality comparisons and intent parsing (ADRs)"
        tags ["intelligence"]
    }

    Report = container "Reports" {
        technology "Rust"
        description "Compliance and report generation utilities"
        tags ["intelligence"]
    }

    // ============================================================
    // CONTAINERS - Skills
    // ============================================================

    Skills = container "Skills System" {
        technology "Markdown, YAML"
        description "AI-readable skill definitions with rules and examples"
        tags ["meta"]
    }

    // ============================================================
    // DATA STORES
    // ============================================================

    DSLFiles = datastore "DSL Files" {
        technology "Filesystem"
        description ".sruja architecture definition files"
    }

    SkillFiles = datastore "Skill Files" {
        technology "Markdown/YAML"
        description "Skill definitions in skills/ directory"
    }

    KnowledgeBase = database "Knowledge Graph Store" {
        technology "In-memory / JSON"
        description "Persisted architecture knowledge graph"
    }
}

// ============================================================
// EXTERNAL SYSTEMS
// ============================================================

IDE = system "IDE" {
    description "VS Code, Cursor, or other LSP-compatible IDE"
}

SourceRepo = system "Source Repository" {
    description "Git repository being analyzed"
}

// ============================================================
// RELATIONSHIPS - Core Dependencies
// ============================================================

// Language depends on Diagnostics
SrujaPlatform.Language -> SrujaPlatform.Diagnostics "reports errors via"

// Engine depends on Language and Diagnostics
SrujaPlatform.Engine -> SrujaPlatform.Language "validates AST from"
SrujaPlatform.Engine -> SrujaPlatform.Diagnostics "emits diagnostics via"

// Export depends on Language
SrujaPlatform.Export -> SrujaPlatform.Language "transforms AST from"
SrujaPlatform.Export -> SrujaPlatform.Diagnostics "reports errors via"

// ============================================================
// RELATIONSHIPS - Interface Dependencies
// ============================================================

// CLI uses all core modules
SrujaPlatform.CLI -> SrujaPlatform.Language "parses via"
SrujaPlatform.CLI -> SrujaPlatform.Engine "validates via"
SrujaPlatform.CLI -> SrujaPlatform.Export "exports via"
SrujaPlatform.CLI -> SrujaPlatform.LSP "can start"

// LSP uses core modules
SrujaPlatform.LSP -> SrujaPlatform.Language "parses via"
SrujaPlatform.LSP -> SrujaPlatform.Engine "validates via"
SrujaPlatform.LSP -> SrujaPlatform.Export "generates previews via"

// WASM bindings
SrujaPlatform.WASM -> SrujaPlatform.Language "parses via"
SrujaPlatform.WASM -> SrujaPlatform.Engine "validates via"
SrujaPlatform.WASM -> SrujaPlatform.Export "exports via"

// VS Code extension
SrujaPlatform.VSCode -> SrujaPlatform.WASM "uses bundled"
SrujaPlatform.VSCode -> SrujaPlatform.CLI "or uses CLI"
IDE -> SrujaPlatform.VSCode "hosts"
IDE -> SrujaPlatform.LSP "connects via LSP protocol"

// ============================================================
// RELATIONSHIPS - Intelligence Dependencies
// ============================================================

// Graph is the central knowledge store
SrujaPlatform.Scan -> SrujaPlatform.Graph "populates"
SrujaPlatform.Diff -> SrujaPlatform.Scan "compares"
SrujaPlatform.Diff -> SrujaPlatform.Graph "reads"
SrujaPlatform.Intent -> SrujaPlatform.Diff "compares"
SrujaPlatform.Report -> SrujaPlatform.Diff "summarizes"

// ============================================================
// RELATIONSHIPS - User Interactions
// ============================================================

Developer -> SrujaPlatform.CLI "runs commands"
Developer -> IDE "edits .sruja files"
Architect -> IDE "edits .sruja files"
AI -> SrujaPlatform.CLI "runs commands"
AI -> SrujaPlatform.Skills "reads rules from"

// ============================================================
// RELATIONSHIPS - Data Flow
// ============================================================

SrujaPlatform.DSLFiles -> SrujaPlatform.Language "read by"
SourceRepo -> SrujaPlatform.Scan "analyzed by"
SrujaPlatform.SkillFiles -> SrujaPlatform.Skills "loaded from"
SrujaPlatform.Graph -> SrujaPlatform.KnowledgeBase "persisted to"

// ============================================================
// REQUIREMENTS
// ============================================================

R1 = requirement functional "Parser must handle all DSL constructs per language spec"
R2 = requirement nonfunctional "Validation must complete in <100ms for 1000 elements"
R3 = requirement constraint "WASM must have feature parity with native for parsing/validation"
R4 = requirement security "No secrets or API keys in DSL files"
R5 = requirement performance "LSP must respond to hover/complete in <50ms"

// ============================================================
// ADRs
// ============================================================

ADR001 = adr "Use Nom parser combinator library" {
    status "accepted"
    context "Need to parse a custom DSL with good error messages"
    decision "Use Nom parser combinators for composable, testable parsers"
    consequences "Gain: Clear error locations, easy testing. Trade-off: Learning curve for contributors"
}

ADR002 = adr "Separate Graph from Language AST" {
    status "accepted"
    context "Language AST is file-centric, but architecture knowledge spans multiple sources"
    decision "Keep KnowledgeGraph as separate data model from DSL AST"
    consequences "Gain: Can merge knowledge from code, chats, ADRs. Trade-off: Synchronization complexity"
}

ADR003 = adr "LLM-only extraction, no regex patterns" {
    status "accepted"
    context "Core platform workflows must be reliable in CI and developer machines without requiring API keys."
    decision "Keep lint/export/discover/drift deterministic; optional LLM usage stays outside the core validation path."
    consequences "Gain: Reproducible results and easy adoption. Trade-off: Some insights require external tooling or skills."
}

// ============================================================
// POLICIES
// ============================================================

LayerPolicy = policy "Enforce layer boundaries" {
    category "architecture"
    enforcement "required"
    description "Intelligence layer must not depend on interface layer; core must not depend on intelligence"
}

NoCyclesPolicy = policy "Acyclic dependencies" {
    category "architecture"
    enforcement "required"
    description "No circular dependencies between crates"
}

// ============================================================
// VIEWS
// ============================================================

view index {
    title "Sruja Platform Context"
    include Developer Architect AI SrujaPlatform IDE SourceRepo
}

view containers of SrujaPlatform {
    title "Sruja Containers"
    include SrujaPlatform.*
    autolayout tb
}

view core_layer {
    title "Core Layer Dependencies"
    include SrujaPlatform.Diagnostics SrujaPlatform.Language SrujaPlatform.Engine SrujaPlatform.Export
}

view intelligence_layer {
    title "Intelligence Layer Dependencies"
    include SrujaPlatform.Graph SrujaPlatform.Scan SrujaPlatform.Diff SrujaPlatform.Intent SrujaPlatform.Report
}

view data_flow {
    title "Data Flow"
    include SrujaPlatform.DSLFiles SrujaPlatform.Language SrujaPlatform.Engine SrujaPlatform.Export SrujaPlatform.Scan SrujaPlatform.Graph
}
