{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sruja.ai/schemas/skill-metadata.json",
  "title": "Skill Rule Metadata",
  "description": "Metadata schema for skill rule files to enable smart filtering, prioritization, and AI context optimization.",
  "type": "object",
  "required": ["metadata"],
  "properties": {
    "metadata": {
      "type": "object",
      "description": "Frontmatter metadata for rule",
      "required": [
        "complexity",
        "frequency",
        "confidence",
        "category",
        "level"
      ],
      "properties": {
        "complexity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "1-5 scale of implementation difficulty (1 = trivial, 5 = very complex)",
          "examples": [1, 2, 3, 4, 5]
        },
        "frequency": {
          "type": "string",
          "enum": ["common", "rare", "very-rare"],
          "description": "How often this pattern appears in typical codebases",
          "examples": ["common", "rare", "very-rare"]
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"],
          "description": "Confidence that this rule is correct in all circumstances",
          "examples": ["high", "medium", "low"]
        },
        "category": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low", "reference"],
          "description": "Priority category of the rule",
          "examples": ["critical", "high", "medium", "low", "reference"]
        },
        "level": {
          "type": "string",
          "enum": ["beginner", "intermediate", "advanced"],
          "description": "Experience level the rule targets",
          "examples": ["beginner", "intermediate", "advanced"]
        },
        "applicable": {
          "type": "object",
          "description": "Context where the rule applies",
          "properties": {
            "is_async": {
              "type": "boolean",
              "description": "Applies to async code",
              "examples": [true, false]
            },
            "embedded": {
              "type": "boolean",
              "description": "Applies to embedded systems",
              "examples": [true, false]
            },
            "wasm": {
              "type": "boolean",
              "description": "Applies to WebAssembly",
              "examples": [true, false]
            },
            "web": {
              "type": "boolean",
              "description": "Applies to web applications",
              "examples": [true, false]
            },
            "cli": {
              "type": "boolean",
              "description": "Applies to CLI applications",
              "examples": [true, false]
            },
            "library": {
              "type": "boolean",
              "description": "Applies to library crates",
              "examples": [true, false]
            }
          },
          "additionalProperties": false
        },
        "rust_version": {
          "type": "string",
          "description": "Minimum Rust version required",
          "examples": ["1.0+", "1.56+", "1.70+"]
        },
        "alternatives": {
          "type": "array",
          "description": "When this rule doesn't apply - alternative approaches",
          "items": {
            "type": "string"
          },
          "examples": [
            "Use clone() in hot-path profiling code",
            "Use clone() when benchmarking proves borrow overhead > 50ns"
          ]
        },
        "related_rules": {
          "type": "array",
          "description": "Related rule IDs for cross-referencing",
          "items": {
            "type": "string"
          },
          "examples": ["own-move-large", "anti-clone-excessive"]
        },
        "tags": {
          "type": "array",
          "description": "Additional tags for categorization",
          "items": {
            "type": "string"
          },
          "examples": ["memory", "performance", "safety", "idiomatic"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "metadata": {
        "complexity": 3,
        "frequency": "common",
        "confidence": "high",
        "applicable": {
          "is_async": true,
          "embedded": false,
          "wasm": false,
          "web": false,
          "cli": false,
          "library": false
        },
        "category": "critical",
        "level": "intermediate",
        "rust_version": "1.0+",
        "alternatives": ["Use clone() in hot-path profiling code"],
        "related_rules": ["own-move-large", "anti-clone-excessive"]
      }
    }
  ]
}
