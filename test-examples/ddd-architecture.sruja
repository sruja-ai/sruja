person = kind "Person"
system = kind "System"
container = kind "Container"
component = kind "Component"
database = kind "Database"

orderSystem = system "Order Management System" {
  orderAPI = container "Order API" {
    orderController = component "Order Controller"
  }
}

// Note: DDD-specific elements (domain, context, aggregate, entity, valueObject, domainEvent)
// are not currently supported in Sruja DSL. This example uses standard elements to represent
// the order management domain.

R1 = requirement functional "System must process orders"
R2 = requirement performance "Response time < 200ms"

ADR001 = adr "Use DDD Architecture" {
  status "accepted"
  context "We need a structured approach to order management"
  decision "We will use Domain-Driven Design for order management"
  consequences "Better domain modeling and separation of concerns"
}
