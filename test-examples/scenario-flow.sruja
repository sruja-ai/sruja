person = kind "Person"
system = kind "System"
container = kind "Container"
component = kind "Component"
database = kind "Database"

user = person "End User"

authSystem = system "Authentication System" {
  authAPI = container "Authentication API" {
    loginService = component "Login Service"
    tokenService = component "Token Service"
  }
  
  userDB = database "User Database"
}

LoginFlow = scenario "User Login Flow" {
  step user -> authSystem.authAPI "submits credentials"
  step authSystem.authAPI -> authSystem.userDB "validates user"
  step authSystem.userDB -> authSystem.authAPI "returns user data"
  step authSystem.authAPI -> user "returns JWT token"
}

AuthenticationFlow = scenario "Authentication Flow" {
  step user -> authSystem.authAPI.loginService "POST /login"
  step authSystem.authAPI.loginService -> authSystem.userDB "SELECT user"
  step authSystem.authAPI.loginService -> authSystem.authAPI.tokenService "generate token"
  step authSystem.authAPI.tokenService -> user "return JWT"
}
