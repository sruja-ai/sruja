# LLM provider and API keys (for sruja eval, extraction, agents)
# Use any supported provider - auto-detects from first key found
#
# OpenRouter (multi-model gateway)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
#
# Or use provider-specific keys:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...  (or GOOGLE_API_KEY)
#
# For local models (no key):
# SRUJA_LLM_PROVIDER=ollama
#
# Override provider: SRUJA_LLM_PROVIDER=openai|openrouter|anthropic|gemini|ollama
# Generic key (override): SRUJA_LLM_API_KEY=sk-...

# Model for LLM extraction (optional, default: openai/gpt-4o-mini)
# Examples: openai/gpt-4o, anthropic/claude-3-haiku, google/gemini-flash-1.5
SRUJA_EXTRACTION_MODEL=minimax/minimax-m2.5

# Default model for self-brainstorming (when no agents in session)
# Developer can chat with this LLM without adding any agent
SRUJA_DEFAULT_MODEL=openai/gpt-4o-mini

# Agent model is configured per-agent by admins (role, knowledge context, model)
