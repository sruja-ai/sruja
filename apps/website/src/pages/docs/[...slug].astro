---
// apps/website/src/pages/docs/[...slug].astro
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ContentDetail from '@/features/content/components/ContentDetail.astro';
import ContentNavigation from '@/features/content/components/ContentNavigation.astro';
import { generateContentPaths } from '@/features/content/utils/paths';
import { getCanonicalUrl, generateBreadcrumbSchema } from '@/utils/seo';
import { envConfig } from '@/config/env';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  // Exclude routes that have specific pages (courses, tutorials, index)
  const excludedSlugs = ['courses', 'tutorials', 'index'];
  const paths = generateContentPaths(
    docs, 
    '/docs', 
    'weight',
    (doc: CollectionEntry<'docs'>) => {
      const slugParts = doc.id.split('/');
      return !excludedSlugs.includes(slugParts[0]);
    }
  );
  
  return paths.map(path => ({
    params: path.params,
    props: {
      doc: path.props.entry,
      previous: path.props.previous,
      next: path.props.next,
    },
  }));
}

type Props = {
  doc: CollectionEntry<'docs'>;
  previous?: { title: string; href: string };
  next?: { title: string; href: string };
};

const { doc, previous, next } = Astro.props as Props;
const { Content } = await doc.render();

const siteUrl = envConfig.siteUrl || 'https://sruja.ai';
const docUrl = `/docs/${doc.id}`;
const canonicalUrl = getCanonicalUrl(docUrl, siteUrl);
const metaDescription = doc.data.summary || doc.data.description || '';

// Generate breadcrumb schema
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Docs', url: '/docs' },
  ...doc.id.split('/').map((part: string, index: number, parts: string[]) => {
    const path = `/docs/${parts.slice(0, index + 1).join('/')}`;
    return { name: part.charAt(0).toUpperCase() + part.slice(1).replace(/-/g, ' '), url: path };
  }),
]);
---

<Layout
  title={doc.data.title}
  description={metaDescription}
  url={docUrl}
  canonical={canonicalUrl}
  structuredData={breadcrumbSchema}
>
  <div class="docs-page">
    <ContentDetail
      title={doc.data.title}
      summary={doc.data.summary}
      description={doc.data.description}
      Content={Content}
      standalone={true}
    />
    <ContentNavigation previous={previous || undefined} next={next || undefined} basePath="/docs" />
  </div>
</Layout>

<style>
  .docs-page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem;
  }

  @media (max-width: 1024px) {
    .docs-page {
      padding: 1.5rem;
    }
  }

  @media (max-width: 768px) {
    .docs-page {
      padding: 1rem;
    }
  }

  @media (max-width: 640px) {
    .docs-page {
      padding: 0.75rem;
    }
  }
</style>
