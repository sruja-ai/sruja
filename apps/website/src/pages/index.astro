---
// apps/website/src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import HeroDemo from '@/features/home/components/HeroDemo';
import { generateOrganizationSchema, generateWebsiteSchema } from '@/utils/seo';

const structuredData = [generateOrganizationSchema(), generateWebsiteSchema()];
---

<Layout
  title="Sruja - Architecture-as-Code for the AI Era"
  description="Developer-friendly language for defining, visualizing, and validating software architecture. Create beautiful architecture diagrams that sync bidirectionally with code, making your architecture AI-assistable and always up-to-date."
  url="/"
  type="website"
  structuredData={structuredData}
>
  <div class="hero">
    <div style="display: flex; justify-content: center; margin-bottom: 12px">
      <img src="/sruja-logo.svg" alt="Sruja" width="56" height="56" />
    </div>
    <h1>Write Code. Get Diagrams. Never Outdated.</h1>
    <p>
      Design, validate, and document your software architecture as code. Write simple text, get
      beautiful diagrams that stay in sync with your code.
    </p>

    <div class="hero-demo-section" style="margin: 3rem 0 2rem; max-width: 900px; margin-inline: auto">
      <p
        style="font-size: 1rem; color: var(--color-text-primary); margin-bottom: 1.5rem; font-weight: 600; text-align: center"
      >
        ✨ Try it live: Edit the code and watch the diagram update automatically
      </p>
      <div class="hero-demo-wrapper">
        <span class="hero-demo-fallback" aria-live="polite">Loading live editor…</span>
        <HeroDemo client:load />
      </div>
    </div>

    <div style="margin: 2.5rem 0 1.5rem; max-width: 700px; margin-inline: auto">
      <p style="font-size: 1.1rem; color: var(--color-text-primary); font-weight: 500">
        Traditional diagrams rot. Wikis get outdated. Sruja keeps your architecture live, valid,
        and version-controlled.
      </p>
    </div>

    <div class="hero-audiences">
      <div class="audience-card">
        <strong>🔄 Prevent Drift</strong>
        <p>
          Code and architecture stay in sync automatically. Bidirectional updates mean your
          diagrams never lie.
        </p>
      </div>
      <div class="audience-card">
        <strong>✅ Single Source of Truth</strong>
        <p>
          Version-controlled in Git. Keep your design, implementation, and documentation aligned
          in one place.
        </p>
      </div>
      <div class="audience-card">
        <strong>🛡️ Enforce Standards</strong>
        <p>
          Define governance rules as code. Automated linting ensures every service meets your
          architectural standards.
        </p>
      </div>
      <div class="audience-card">
        <strong>👁️ Visualize Anything</strong>
        <p>
          Generate Context, Container, Component, and Deployment views from a single model.
          Export to C4, Mermaid, and more.
        </p>
      </div>
    </div>

    <p>
      Try the <a href="/designer">Sruja Designer</a> to see bidirectional sync in action,
      explore <a href="/docs/examples">real-world examples</a>, or start with our
      <a href="/courses">comprehensive courses</a>.
    </p>
    <div class="hero-actions">
      <a href="/designer" class="hero-btn primary">🚀 Try Now in Designer</a>
      <a href="/docs/getting-started" class="hero-btn secondary">Get Started</a>
      <a href="/docs/examples" class="hero-btn outline">View Examples</a>
      <a href="/docs" class="hero-btn outline">Search</a>
    </div>
  </div>
</Layout>

<style>
  :global(.hero) {
    max-width: 800px;
    margin: 4rem auto;
    padding: 0 2rem;
    text-align: center;
    min-height: 50vh;
  }

  /* Wrapper so the demo section always has height; fallback hidden once island mounts */
  :global(.hero-demo-wrapper) {
    position: relative;
    min-height: 640px;
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 8px;
    overflow: hidden;
    background: var(--color-surface, #f8fafc);
  }

  :global(.hero-demo-fallback) {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9375rem;
    color: var(--color-text-secondary, #64748b);
    background: var(--color-surface, #f8fafc);
  }

  /* Hide fallback once the live editor has mounted (has viewer-editor test id) */
  :global(.hero-demo-wrapper:has([data-testid="viewer-editor"])) .hero-demo-fallback {
    display: none;
  }

  :global(.hero h1) {
    font-size: 3rem;
    font-weight: 700;
    margin: 0 0 1.5rem 0;
    line-height: 1.2;
  }

  :global(.hero p) {
    font-size: 1.25rem;
    color: #64748b;
    margin: 1rem 0;
    line-height: 1.6;
  }

  /* Fix Monaco editor gap issue on homepage - force compact gutter */
  :global(.hero .monaco-editor .glyph-margin) {
    display: none !important;
  }

  /* Gutter as narrow as possible for 2-digit line numbers (16 lines) */
  :global(.hero .monaco-editor .margin) {
    width: 28px !important;
    min-width: 28px !important;
    max-width: 28px !important;
  }

  :global(.hero .monaco-editor .line-numbers) {
    width: 100% !important;
    padding: 0 4px !important;
  }

  /* Remove any extra spacing in margin overlays */
  :global(.hero .monaco-editor .margin-view-overlays) {
    width: 100% !important;
  }

  /* No extra left padding on editor content - avoid “too much indentation” look */
  :global(.hero .monaco-editor .monaco-scrollable-element),
  :global(.hero .monaco-editor .view-lines),
  :global(.hero .monaco-editor .view-line),
  :global(.hero .monaco-editor .lines-content) {
    padding-left: 0 !important;
    margin-left: 0 !important;
  }
  :global(.hero .monaco-editor .view-lines),
  :global(.hero .monaco-editor .monaco-scrollable-element > .margin-view-overlays) {
    left: 0 !important;
  }

  :global(.hero a) {
    color: var(--color-primary);
    text-decoration: none;
  }

  :global(.hero a:hover) {
    color: var(--color-primary-hover);
    text-decoration: underline;
  }

  :global(.hero-actions) {
    display: flex;
    gap: 1rem;
    justify-content: center;
    align-items: center;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  :global(.hero-btn) {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: 0.5rem;
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
    border: 1px solid transparent;
  }
  :global(.hero-btn.primary) {
    background: var(--color-primary, #7c3aed);
    color: #fff;
    border-color: var(--color-primary, #7c3aed);
  }
  :global(.hero-btn.primary:hover) {
    background: var(--color-primary-hover, #6d28d9);
    border-color: var(--color-primary-hover, #6d28d9);
  }
  :global(.hero-btn.secondary) {
    background: var(--color-surface, #f1f5f9);
    color: var(--color-text-primary, #0f172a);
    border-color: var(--color-border, #e2e8f0);
  }
  :global(.hero-btn.secondary:hover) {
    background: var(--color-border, #e2e8f0);
  }
  :global(.hero-btn.outline) {
    background: transparent;
    color: var(--color-primary, #7c3aed);
    border-color: var(--color-primary, #7c3aed);
  }
  :global(.hero-btn.outline:hover) {
    background: var(--color-surface, #f8fafc);
  }

  :global(.hero-audiences) {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin: 2rem 0;
    padding: 1.5rem 0;
  }

  :global(.audience-card) {
    padding: 1rem;
    background: var(--color-surface, #f8fafc);
    border-radius: 0.5rem;
    border: 1px solid var(--color-border, #e2e8f0);
  }

  :global(html.dark) .audience-card {
    background: #1e293b;
    border-color: #334155;
  }

  :global(.audience-card strong) {
    display: block;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-primary, #0f172a);
    margin-bottom: 0.5rem;
  }

  :global(html.dark) .audience-card strong {
    color: #f1f5f9;
  }

  :global(.audience-card p) {
    font-size: 0.875rem;
    color: var(--color-text-secondary, #64748b);
    margin: 0;
    line-height: 1.5;
  }

  :global(html.dark) .audience-card p {
    color: #cbd5e1;
  }

  @media (max-width: 768px) {
    :global(.hero-audiences) {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      margin: 1.5rem 0;
    }
  }

  @media (max-width: 1024px) {
    :global(.hero) {
      margin: 3rem auto;
      padding: 0 1.5rem;
    }

    :global(.hero h1) {
      font-size: 2.5rem;
    }

    :global(.hero p) {
      font-size: 1.125rem;
    }
  }

  @media (max-width: 768px) {
    :global(.hero) {
      margin: 2rem auto;
      padding: 0 1rem;
    }

    :global(.hero h1) {
      font-size: 2rem;
      margin-bottom: 1rem;
    }

    :global(.hero p) {
      font-size: 1rem;
    }

    :global(.hero-actions) {
      gap: 0.75rem;
      margin-top: 1.5rem;
    }
  }

  @media (max-width: 640px) {
    :global(.hero) {
      margin: 1.5rem auto;
      padding: 0 0.75rem;
    }

    :global(.hero h1) {
      font-size: 1.75rem;
    }

    :global(.hero p) {
      font-size: 0.9375rem;
    }
  }
</style>
