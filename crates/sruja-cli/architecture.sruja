// Sruja CLI Crate Architecture
// Focus: Commands, Federation, and MCP Interface.

cli = system "sruja-cli" {
  description "Core CLI and user interaction layer for Sruja"

  DslCommands = container "DSL Domain Commands" {
    technology "Rust, clap"
    description "Sub-commands for DSL actions (lint, fmt, diff, etc.)"
  }

  ScanCommands = container "Scan Domain Commands" {
    technology "Rust, clap"
    description "Sub-commands for scan and graph actions (drift, why, health, etc.)"
  }

  IntentCommands = container "Intent Domain Commands" {
    technology "Rust, clap"
    description "Sub-commands for intent check and agent propose actions"
  }

  UtilityCommands = container "Utility Domain Commands" {
    technology "Rust, clap"
    description "Sub-commands for onboarding, version, compliance, etc."
  }

  Federation = container "Federated Engine" {
    technology "Rust"
    description "Core federation logic for publishing bundles and composing system indexes"
  }

  Context = container "TaskContext Resolver" {
    technology "Rust"
    description "Precision context resolver (TaskContext v1) for AI agents"
  }

  MCP = container "MCP Server" {
    technology "Rust"
    description "Model Context Protocol server for IDE agent integration"
  }
}

cli -> cli.DslCommands "dispatches via"
cli -> cli.ScanCommands "dispatches via"
cli -> cli.IntentCommands "dispatches via"
cli -> cli.UtilityCommands "dispatches via"

cli.UtilityCommands -> cli.Federation "uses for multi-repo composition"
cli.IntentCommands -> cli.Context "invokes for task-scoped context"
cli.MCP -> cli.Context "exposes resolution tools via"
