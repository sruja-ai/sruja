{
  "name": "sruja-monorepo",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:website": "turbo run dev --filter=@sruja/website...",
    "dev:storybook": "turbo run dev --filter=@sruja/storybook...",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "clean": "rimraf dist && turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "prepare": "node -e \"if (process.env.HUSKY === '0' || process.env.CI === 'true') process.exit(0); try { require('child_process').execSync('husky', {stdio: 'inherit'}); } catch(e) { process.exit(0); }\"",
    "check:unused": "ts-prune --project tsconfig.json || true",
    "check:unused:files": "unimported || true",
    "check:unused:deps": "depcheck || true",
    "check:unused:all": "npm run check:unused && npm run check:unused:files && npm run check:unused:deps"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.1.1",
    "binaryen": "^125.0.0",
    "depcheck": "^1.4.7",
    "glob": "^11.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.2.5",
    "size-limit": "^11.1.1",
    "terser": "^5.44.1",
    "ts-prune": "^0.10.3",
    "turbo": "^2.8.3",
    "unimported": "^1.31.0",
    "vite-plugin-node-polyfills": "^0.24.0",
    "zx": "^8.8.5"
  },
  "packageManager": "npm@10.2.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "lodash-es": "4.17.23",
    "lodash": "4.17.23",
    "elliptic": "6.6.1",
    "diff": "8.0.3",
    "mocha": {
      "diff": "8.0.3"
    },
    "browserify-sign": {
      "elliptic": "6.6.1"
    },
    "create-ecdh": {
      "elliptic": "6.6.1"
    },
    "crypto-browserify": {
      "browserify-sign": {
        "elliptic": "6.6.1"
      },
      "create-ecdh": {
        "elliptic": "6.6.1"
      }
    },
    "node-stdlib-browser": {
      "crypto-browserify": {
        "browserify-sign": {
          "elliptic": "6.6.1"
        },
        "create-ecdh": {
          "elliptic": "6.6.1"
        }
      }
    },
    "yaml-language-server": {
      "lodash": "4.17.23"
    },
    "volar-service-yaml": {
      "yaml-language-server": {
        "lodash": "4.17.23"
      }
    },
    "@astrojs/language-server": {
      "volar-service-yaml": {
        "yaml-language-server": {
          "lodash": "4.17.23"
        }
      }
    },
    "@chevrotain/gast": {
      "lodash-es": "4.17.23"
    },
    "@chevrotain/cst-dts-gen": {
      "lodash-es": "4.17.23",
      "@chevrotain/gast": {
        "lodash-es": "4.17.23"
      }
    },
    "chevrotain": {
      "lodash-es": "4.17.23",
      "@chevrotain/gast": {
        "lodash-es": "4.17.23"
      },
      "@chevrotain/cst-dts-gen": {
        "lodash-es": "4.17.23"
      }
    },
    "langium": {
      "chevrotain": {
        "lodash-es": "4.17.23"
      }
    },
    "@mermaid-js/parser": {
      "langium": {
        "chevrotain": {
          "lodash-es": "4.17.23"
        }
      }
    },
    "mermaid": {
      "lodash-es": "4.17.23",
      "@mermaid-js/parser": {
        "langium": {
          "chevrotain": {
            "lodash-es": "4.17.23"
          }
        }
      }
    }
  }
}
