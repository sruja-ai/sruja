// Generated architecture for Express.js
// Generated by: Sruja AI Architecture Analysis
// Date: 2024-01-15
// Confidence: Medium-High

// Import standard library
import { * } from 'sruja.ai/stdlib'

// Main Express system
express = system "Express.js Framework" {
  description "Fast, unopinionated, minimalist web framework for Node.js (v4.18.x, JavaScript, MIT). Main file lib/express.js."

  // Core Application
  app = container "Express Application" {
    technology "Node.js"
    description "Main application instance that manages routing and middleware (entry express(), lib/express.js)"
  }

  // Router System
  router = container "Router" {
    technology "Node.js"
    description "Routes HTTP requests to appropriate handlers"

    routing = component "Routing Logic" {
      description "Matches URLs to route handlers (lib/router/index.js, GET/POST/PUT/DELETE/PATCH)"
    }

    layer = component "Layer System" {
      description "Manages middleware and route handlers in stack"
    }
  }

  // Middleware Pipeline
  middleware = container "Middleware System" {
    technology "Node.js"
    description "Processes requests through middleware chain"

    pipeline = component "Middleware Chain" {
      description "Sequential execution of middleware functions"
    }

    builtins = component "Built-in Middleware" {
      description "express.json, express.static, express.urlencoded"
    }
  }

  // Request/Response Handling
  request = container "Request Handler" {
    technology "Node.js"
    description "HTTP request abstraction (extends http.IncomingMessage, lib/request.js)"
  }

  response = container "Response Handler" {
    technology "Node.js"
    description "HTTP response abstraction with helper methods (extends http.ServerResponse, lib/response.js: send, json, render, redirect)"
  }

  // View System
  view = container "View System" {
    technology "Node.js"
    description "Template rendering support (optional; engines: pug, ejs, hbs, etc)"
  }

  // Query Parser
  queryParser = component "Query Parser" {
    description "Parses URL query strings (dependency qs)"
  }

  // Internal relationships
  app -> router "delegates routing to"
  app -> middleware "processes requests through"
  router.routing -> router.layer "uses layer stack"
  router.layer -> middleware.pipeline "dispatches to"
  router.routing -> middleware.pipeline "routes to handlers via"
  middleware.pipeline -> middleware.builtins "may use"
  middleware.pipeline -> request "modifies"
  middleware.pipeline -> response "modifies"
  app -> view "optional template rendering via"
  router -> queryParser "uses"
}

// External dependencies
nodejs = system "Node.js Runtime" {
  description "JavaScript runtime environment"

  http = container "HTTP Module" {
    technology "Node.js"
    description "Built-in HTTP server and client"
  }

  events = container "Events Module" {
    technology "Node.js"
    description "Event-driven architecture support"
  }
}

npm = system "NPM Ecosystem" {
  description "External npm packages"

  bodyParser = container "Body Parser" {
    technology "body-parser package"
    description "Parse incoming request bodies (deprecated in Express 4.16+; use express.json(), express.urlencoded())"
  }

  cookieParser = container "Cookie Parser" {
    technology "cookie-parser package"
    description "Parse Cookie header and populate req.cookies (optional)"
  }
}

// User (developer using Express)
developer = person "Developer" {
  description "Software developer building web applications with Express"
}

// Application built with Express
webApp = system "Web Application" {
  description "Application built using Express framework"

  customMiddleware = container "Custom Middleware" {
    technology "JavaScript"
    description "Application-specific middleware functions"
  }

  routes = container "Route Handlers" {
    technology "JavaScript"
    description "Application route definitions and handlers"
  }

  templates = container "Views/Templates" {
    technology "Template Engine"
    description "Application views and templates"
  }
}

// Relationships
developer -> express.app "creates application using"
express -> nodejs "runs on"
express -> nodejs.http "built on"
express -> nodejs.events "uses event emitter pattern"
express.app -> npm.bodyParser "optional integration with"
express.app -> npm.cookieParser "optional integration with"
express.app -> npm "optional integration with other packages"
express.middleware -> REQ001 "implements"
express.router -> REQ002 "implements"
express.app -> REQ003 "addresses"
webApp -> express "uses framework"
webApp.customMiddleware -> express.middleware "extends"
webApp.routes -> express.router "uses"
webApp.templates -> express.view "renders via"

// Requirements captured from analysis
REQ001 = requirement functional "Framework must support middleware pattern" {
  tags ["express.middleware"]
}

REQ002 = requirement functional "Framework must support HTTP routing" {
  tags ["express.router"]
}

REQ003 = requirement performance "Framework must handle high request throughput" {
  tags ["express.app"]
}

// Architectural Decision Records
ADR001 = adr "Use middleware pattern for extensibility" {
  status "Accepted"
  context "Express needs to be minimal but extensible"
  decision "Implement middleware chain pattern where each function can modify req/res"
  consequences "Highly extensible but can be hard to debug middleware order"
  tags ["express.middleware"]
}

ADR002 = adr "Built-in body parsing deprecated in 4.16.0" {
  status "Accepted"
  context "Body parsing was previously done by body-parser package"
  decision "Include body parsing directly in Express 4.16+"
  consequences "Simpler setup, one less dependency, but larger core"
  tags ["express.app", "npm.bodyParser"]
}

// Policies
StyleGuide = policy "Express coding style guidelines" {
  category "development"
  enforcement "recommended"
}

// Confidence levels
// HIGH: Core app, router, middleware, request/response
// MEDIUM: View system, query parser
// LOW: Specific implementation details, optional integrations
// MISSING: Test infrastructure, examples, documentation site

// Gaps identified:
// - Test infrastructure (mocha, supertest)
// - Example applications
// - Documentation generation
// - Benchmarking infrastructure
// - Contribution flow
