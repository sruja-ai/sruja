// FastAPI Architecture - DEEP scope WITH Sruja skill
// Using GENERIC patterns found via updated skill's search commands
// grep -riE "(catch|except|error|router|middleware|debug|cache)" fastapi/

fastapi = system "FastAPI Framework" {
  description "High performance async Python web framework. Entry: fastapi.FastAPI class. Extends Starlette."
  
  app = container "FastAPI Application" {
    technology "Python 3.10+"
    description "Main app class extending Starlette. fastapi/applications.py:45"
    
    config = component "Configuration" {
      description "Settings: debug, title, version, docs_url, openapi_url"
    }
    
    debugFlag = component "Debug Mode" {
      description "Enables debug tracebacks on errors. Affects ServerErrorMiddleware"
    }
    
    lifespan = component "Lifespan Handler" {
      description "Async context manager for startup/shutdown events"
    }
    
    exceptionHandlers = component "Exception Handlers" {
      description "Default handlers for HTTPException, Customizable via exception_handlers param."
    }
    
    config -> debugFlag "controls"
  }
  
  router = container "APIRouter" {
    technology "Python"
    description "Route registration. fastapi/routing.py. Supports include_router() composition"
    
    routes = component "Route Registry" {
      description "Stores path operations with dependencies and validation"
    }
    
    webhooks = component "Webhooks" {
      description "APIRouter for webhook definitions in OpenAPI"
    }
    
    webhooks -> routes "extends"
  }
  
  dependencies = container "Dependency Injection" {
    technology "Python"
    description "Injects dependencies via Depends(). fastapi/dependencies/utils.py"
    
    solver = component "Dependency Solver" {
      description "Resolves dependency graph via solve_dependencies()"
    }
    
    cache = component "Dependency Cache" {
      description "Per-request cache. use_cache=True in Depends()"
    }
    
    solver -> cache "stores resolved deps in"
  }
  
  middleware = container "Middleware Pipeline" {
    technology "Starlette"
    description "Request processing chain using Starlette patterns"
    
    exceptionMiddleware = component "Exception Middleware" {
      description "Catches exceptions, routes to handlers. starlette.middleware.exceptions"
    }
    
    serverErrorMiddleware = component "Server Error Middleware" {
      description "Catches unhandled errors. Debug mode controls tracebacks. starlette.middleware.errors"
    }
    
    asyncExitStack = component "AsyncExitStack Middleware" {
      description "Manages async context managers for dependencies"
    }
    
    serverErrorMiddleware -> exceptionMiddleware "wraps"
    exceptionMiddleware -> asyncExitStack "wraps"
  }
  
  request = container "Request Handler" {
    technology "Starlette"
    description "HTTP request abstraction. starlette.requests.Request"
    
    validation = component "Request Validation" {
      description "Validates via Pydantic. Raises RequestValidationError"
    }
  }
  
  response = container "Response Handler" {
    technology "Starlette"
    description "HTTP response. Supports JSONResponse, StreamingResponse"
    
    serialization = component "Serialization" {
      description "jsonable_encoder converts Pydantic models to JSON dicts"
    }
    
    validation = component "Response Validation" {
      description "Optional response_model validation"
    }
    
    serialization -> validation "validates before serializing"
  }
  
  openapi = container "OpenAPI Generator" {
    technology "Python"
    description "Auto-generates OpenAPI 3.1 schema from routes and Pydantic models"
    
    schema = component "Schema Generator" {
      description "get_openapi() generates JSON schema"
    }
    
    docs = component "Documentation UI" {
      description "Swagger UI and ReDoc endpoints"
    }
    
    schema -> docs "powers"
  }
  
  // Internal relationships
  app -> router "creates default APIRouter"
  app -> middleware "configures middleware stack"
  app -> openapi "generates docs from routes"
  router.routes -> dependencies.solver "injects into route handlers"
  router.routes -> request.validation "validates requests"
  router.routes -> response.serialization "serializes responses"
  middleware.exceptionMiddleware -> app.exceptionHandlers "routes to"
  app.debugFlag -> middleware.serverErrorMiddleware "enables tracebacks"
}

starlette = system "Starlette" {
  description "ASGI framework. FastAPI extends this for routing, middleware, ASGI app"
  
  asgi = container "ASGI App" {
    technology "Python ASGI"
    description "ASGI interface. __call__(scope, receive, send)"
  }
  
  routing = container "Starlette Routing" {
    technology "Python"
    description "Route matching. BaseRoute, Router classes"
  }
  
  middleware = container "Starlette Middleware" {
    technology "Python"
    description "Middleware base classes. BaseHTTPMiddleware, Middleware"
  }
}

pydantic = system "Pydantic" {
  description "Data validation using Python type hints. pydantic>=2.7.0"
  
  models = container "Pydantic Models" {
    technology "Python"
    description "BaseModel classes for request/response validation"
  }
  
  validation = container "Validation Engine" {
    technology "Python"
    description "Validates data against type hints. Raises ValidationError"
  }
  
  models -> validation "defines schemas for"
}

python = system "Python Runtime" {
  description "Python 3.10+ async runtime"
  
  asyncio = container "Asyncio" {
    technology "Python asyncio"
    description "Async runtime via anyio library"
  }
}

developer = person "Developer" {
  description "Developer building async web APIs with FastAPI"
}

userApp = system "User Application" {
  description "Application built using FastAPI"
  
  mainApp = container "Main App" {
    technology "FastAPI"
    description "Primary FastAPI instance"
  }
  
  subRouter = container "Sub-Router" {
    technology "FastAPI APIRouter"
    description "Modular router via include_router()"
  }
  
  models = container "Pydantic Models" {
    technology "Pydantic"
    description "Request/response models"
  }
  
  mainApp -> subRouter "includes via app.include_router()"
}

// External relationships
developer -> fastapi.app "creates app via FastAPI()"
fastapi.app -> starlette "extends Starlette class"
fastapi.app.lifespan -> starlette.asgi "manages via ASGI lifespan"
fastapi.router -> starlette.routing "uses Starlette routing"
fastapi.middleware -> starlette.middleware "uses Starlette middleware"
fastapi.request -> starlette "uses Starlette request"
fastapi.response -> starlette "uses Starlette response"
fastapi -> pydantic "uses for validation"
fastapi.request.validation -> pydantic.validation "delegates to"
fastapi.response.serialization -> pydantic.models "serializes from"
fastapi.dependencies -> python "uses Python async"
fastapi.dependencies.solver -> python.asyncio "uses async context managers"
fastapi.openapi.schema -> pydantic.models "generates schema from"
fastapi.openapi.docs -> pydantic.models "documents from"
pydantic.models -> python "uses type hints from"
pydantic.validation -> python "validates against"

userApp -> fastapi "imports framework"
userApp.mainApp -> fastapi.app "creates instance"
userApp.subRouter -> fastapi.router "extends APIRouter"
userApp.models -> pydantic.models "defines"

// Requirements
REQ001 = requirement functional "Framework must support async request handling" {
  tags ["fastapi.app"]
  description "FastAPI is async-first, all route handlers can be async"
}

REQ002 = requirement functional "Framework must support dependency injection" {
  tags ["fastapi.dependencies"]
  description "Inject dependencies via Depends() with per-request caching"
}

REQ003 = requirement functional "Framework must generate OpenAPI documentation" {
  tags ["fastapi.openapi"]
  description "Auto-generate OpenAPI 3.1 schema from routes and Pydantic models"
}

REQ004 = requirement operational "Framework must handle errors gracefully" {
  tags ["fastapi.middleware"]
  description "Default exception handlers for HTTPException, ValidationError. Customizable."
}

fastapi.app -> REQ001 "implements async"
fastapi.dependencies -> REQ002 "implements DI"
fastapi.openapi -> REQ003 "implements docs"
fastapi.middleware -> REQ004 "implements error handling"
