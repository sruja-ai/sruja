# =============================================================================
# Sruja LLM configuration (optional)
# =============================================================================
#
# Used by: ./run_demo.sh --llm, ./evaluate_architecture.sh <repo> --llm, sruja eval
#
# Fast path works without this — no config required for quickstart/drift/scan.
# Do not commit .env or real keys.
#
# -----------------------------------------------------------------------------
# Quick start
# -----------------------------------------------------------------------------
# 1. cp .env.example .env
# 2. Set one key below (uncomment and replace placeholder)
# 3. Verify: ./run_demo.sh --llm   or   ./evaluate_architecture.sh express --llm
#
# -----------------------------------------------------------------------------
# Provider-specific keys (first one set is used if SRUJA_LLM_PROVIDER is unset)
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# GOOGLE_API_KEY=...   # alternative to GEMINI_API_KEY
#
# -----------------------------------------------------------------------------
# Generic key (any provider)
# -----------------------------------------------------------------------------
# If set, used for the auto-selected provider. Overrides provider-specific key.
# SRUJA_LLM_API_KEY=sk-...
#
# -----------------------------------------------------------------------------
# Local models (no API key)
# -----------------------------------------------------------------------------
# SRUJA_LLM_PROVIDER=ollama
#
# -----------------------------------------------------------------------------
# Override provider (default: auto-detect from keys above)
# -----------------------------------------------------------------------------
# SRUJA_LLM_PROVIDER=openai|openrouter|anthropic|gemini|ollama
#
# -----------------------------------------------------------------------------
# Verify
# -----------------------------------------------------------------------------
# From this directory: ./run_demo.sh --llm
# If you see "LLM evaluation complete", the configuration is working.
