+#[cfg(test)]
+mod rename_tests {
+    use super::*;
+
+    #[test]
+    fn learning_entry_rename_serde_compat() {
+        let json = r#"{"id":"t","timestamp":"2026-01-01T00:00:00Z","context":"c","hypothesis":"h","guardrail_advice":"a"}"#;
+        let entry: LearningEntry = serde_json::from_str(json).unwrap();
+        assert_eq!(entry.situation, "c");
+        assert_eq!(entry.suggested_behavior, "a");
+    }
+
+    #[test]
+    fn learning_entry_playbook_factory() {
+        let entry = LearningEntry::playbook("s", "h", "a");
+        assert_eq!(entry.kind, Some(LearningKind::Playbook));
+        assert_eq!(entry.situation, "s");
+        assert_eq!(entry.suggested_behavior, "a");
+    }
+}
