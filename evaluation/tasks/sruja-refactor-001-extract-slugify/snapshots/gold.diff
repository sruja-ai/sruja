@@ -0,0 +1,20 @@
+//! Shared utility functions.
+
+/// Convert a string to a URL-friendly slug.
+///
+/// - Lowercases the input
+/// - Removes non-alphanumeric characters (except spaces, hyphens, underscores, dots)
+/// - Converts spaces/underscores/dots to hyphens
+/// - Deduplicates consecutive hyphens
+/// - Trims leading/trailing hyphens
+/// - Truncates to 50 characters
+pub fn slugify(s: &str) -> String {
+    let mut out = String::new();
+    for ch in s.chars() {
+        if ch.is_ascii_alphanumeric() {
+            out.push(ch.to_ascii_lowercase());
+        } else if (ch.is_whitespace() || ch == '-' || ch == '_' || ch == '.') && !out.ends_with('-')
+        {
+            out.push('-');
+        }
+    }
+    out.trim_matches('-').chars().take(50).collect()
+}
