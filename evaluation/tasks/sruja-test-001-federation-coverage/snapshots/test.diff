+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::fs;
+    use tempfile::tempdir;
+
+    #[test]
+    fn infer_repo_id_from_directory_name() {
+        let dir = tempdir().unwrap();
+        let repo_path = dir.path().join("my-project");
+        fs::create_dir(&repo_path).unwrap();
+        let repo_id = infer_repo_id(&repo_path);
+        assert_eq!(repo_id, "my-project");
+    }
+
+    #[test]
+    fn infer_repo_id_falls_back_to_unknown() {
+        let dir = tempdir().unwrap();
+        let repo_id = infer_repo_id(dir.path());
+        // Returns the temp dir name (non-empty, non-".")
+        assert!(!repo_id.is_empty());
+        assert_ne!(repo_id, ".");
+    }
+
+    #[test]
+    fn git_commit_short_returns_none_outside_git_repo() {
+        let dir = tempdir().unwrap();
+        let commit = git_commit_short(dir.path());
+        assert!(commit.is_none());
+    }
+}
