+
+    #[test]
+    fn mutex_poisoning_does_not_panic() {
+        use std::sync::Arc;
+        use std::thread;
+        let router = ModelRouter::new(Arc::new(FakeClient));
+        let router_clone = Arc::new(router);
+        let router_for_thread = router_clone.clone();
+        let handle = thread::spawn(move || {
+            drop(router_for_thread);
+        });
+        handle.join().unwrap();
+        let spent = router_clone.spent_usd();
+        assert!(spent >= 0.0);
+    }
